# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
# Any chat model available on your Groq account, e.g. one listed at console.groq.com/docs/models
GROQ_MODEL=

# Retrieval
TOP_K=4
SIMILARITY_THRESHOLD=0.30

# Chunking (tokens counted with the embedding model's tokenizer)
CHUNK_TOKENS=500
CHUNK_OVERLAP=50

# Input limits and rate limiting
MAX_QUESTION_LENGTH=500
RATE_LIMIT_PER_MINUTE=20

# LLM call behaviour
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=3

# Paths
DOCS_DIR=data/docs
INDEX_DIR=index